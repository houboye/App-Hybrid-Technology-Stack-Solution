<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AndroidDemoProject">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AndroidDemoProject">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- React Native Container -->
        <activity
            android:name=".bridges.rn.RNContainerActivity"
            android:theme="@style/Theme.AndroidDemoProject" />

        <!-- Flutter Container -->
        <activity
            android:name=".bridges.flutter.FlutterContainerActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:theme="@style/Theme.AndroidDemoProject"
            android:windowSoftInputMode="adjustResize" />

        <!-- WebView Container -->
        <activity
            android:name=".bridges.webview.WebViewContainerActivity"
            android:theme="@style/Theme.AndroidDemoProject" />

        <!-- Native Demo -->
        <activity
            android:name=".demo.NativeDemoActivity"
            android:theme="@style/Theme.AndroidDemoProject" />
    </application>

</manifest>